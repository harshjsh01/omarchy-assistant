#!/usr/bin/env bash
#
# Omarchy Voice Assistant CLI
# Controls the voice daemon, triggers listening, and manages configuration.
#

set -euo pipefail

SOCKET_PATH="/tmp/omarchy-assistant.sock"
CONFIG_FILE="${HOME}/.config/omarchy-assistant/config.json"
REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="$(cd "$(dirname "$REAL_PATH")/.." && pwd)"

usage() {
    cat <<USAGE
Omarchy Voice Assistant — Hands-free voice control for Omarchy Linux

Usage:
  omarchy-assistant listen                 Trigger voice listening cycle (push-to-talk)
  omarchy-assistant continuous [start|stop] Hands-free continuous listening mode
  omarchy-assistant chat [--cli|--log]    View live chat log or attach to interactive Antigravity CLI
  omarchy-assistant test-stt [--loop|-s N] Test speech-to-text live without executing commands
  omarchy-assistant stop-listening        Cancel the active listening cycle
  omarchy-assistant exec "<command>"       Execute a voice command via text (dry-run/test)
  omarchy-assistant status                 Show daemon status and configuration
  omarchy-assistant start                  Start assistant daemon in background
  omarchy-assistant stop                   Stop assistant daemon
  omarchy-assistant restart                Restart assistant daemon
  omarchy-assistant daemon-service         Run daemon in foreground (for systemd)
  omarchy-assistant meeting start          Start dual-channel meeting recording & transcription
  omarchy-assistant meeting stop           Stop meeting and generate Markdown transcript + summary
  omarchy-assistant meeting status         Check active meeting recording status
  omarchy-assistant meeting list           List saved meeting transcripts
  omarchy-assistant help                   Show this help message

Examples:
  omarchy-assistant listen
  omarchy-assistant exec "switch to workspace 2"
  omarchy-assistant exec "volume up"
  omarchy-assistant exec "take screenshot"
USAGE
}

is_daemon_running() {
    [[ -S "$SOCKET_PATH" ]]
}

send_socket() {
    local payload="$1"
    python3 -c '
import sys, socket, json
sock_path = "'"$SOCKET_PATH"'"
payload = json.loads(sys.argv[1])
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(5.0)
        s.connect(sock_path)
        s.sendall(json.dumps(payload).encode("utf-8"))
        res = s.recv(4096)
        print(res.decode("utf-8"))
except Exception as e:
    print(json.dumps({"status": "error", "message": str(e)}))
    sys.exit(1)
' "$payload"
}

cmd="${1:-listen}"

case "$cmd" in
    listen|trigger)
        echo "🎙️ I'm live, how may I assist you today?"
        if ! is_daemon_running; then
            echo "[omarchy-assistant] Daemon not active. Launching daemon session..."
            PYTHONPATH="$REPO_DIR" python3 -m daemon.main >/dev/null 2>&1 &
            sleep 0.8
        fi
        send_socket '{"action": "listen"}'
        ;;

    stop-listening)
        if is_daemon_running; then
            send_socket '{"action": "stop_listening"}'
        fi
        ;;

    continuous)
        sub="${2:-toggle}"
        if ! is_daemon_running; then
            echo "[omarchy-assistant] Daemon not active. Launching daemon session..."
            PYTHONPATH="$REPO_DIR" python3 -m daemon.main >/dev/null 2>&1 &
            sleep 0.8
        fi
        case "$sub" in
            start)
                send_socket '{"action": "continuous_start"}'
                ;;
            stop)
                send_socket '{"action": "continuous_stop"}'
                ;;
            toggle)
                send_socket '{"action": "continuous_toggle"}'
                ;;
            status)
                send_socket '{"action": "continuous_status"}'
                ;;
            *)
                echo "Usage: omarchy-assistant continuous {start|stop|toggle|status}"
                ;;
        esac
        ;;

    exec|execute)
        shift || true
        text="${*:-}"
        if [[ -z "$text" ]]; then
            echo "Error: No command text provided." >&2
            echo "Usage: omarchy-assistant exec \"open terminal\"" >&2
            exit 1
        fi

        if is_daemon_running; then
            send_socket "{\"action\": \"execute\", \"text\": \"$text\"}"
        else
            PYTHONPATH="$REPO_DIR" python3 -m daemon.main --test-text "$text"
        fi
        ;;

    chat)
        mode="${2:-live}"
        cid_file="${HOME}/.config/omarchy-assistant/active_conversation_id.txt"
        chat_log="${HOME}/Work/CHAT.md"
        active_cid=""
        if [[ -f "$cid_file" ]]; then
            active_cid="$(cat "$cid_file")"
        fi

        case "$mode" in
            --cli|cli|interactive)
                echo "🤖 Attaching to active Antigravity CLI session (Conversation: ${active_cid:-latest})..."
                if [[ -n "$active_cid" ]]; then
                    exec agy --conversation "$active_cid"
                else
                    exec agy --continue
                fi
                ;;
            --log|log)
                if [[ -f "$chat_log" ]]; then
                    exec less -R "$chat_log"
                else
                    echo "No chat log found at $chat_log yet."
                fi
                ;;
            *)
                echo -e "\033[1;36m================================================================\033[0m"
                echo -e " 🤖 \033[1;37mBro Voice Assistant — Live Antigravity Chat\033[0m"
                echo -e " \033[1;34mActive Conversation ID:\033[0m ${active_cid:-None}"
                echo -e " \033[1;34mChat Log:\033[0m $chat_log"
                echo -e " \033[0;33mTip: Run 'omarchy-assistant chat --cli' to enter interactive CLI\033[0m"
                echo -e "\033[1;36m================================================================\033[0m"
                echo ""
                touch "$chat_log"
                tail -n 35 -f "$chat_log"
                ;;
        esac
        ;;

    test-stt|stt-test|stt)
        shift || true
        PYTHONPATH="$REPO_DIR" python3 -m daemon.test_stt "$@"
        ;;

    set-key)
        provider="${2:-}"
        key="${3:-}"
        if [[ -z "$provider" || -z "$key" ]]; then
            echo "Usage: omarchy-assistant set-key {sarvam|gemini|groq|openai} \"YOUR_API_KEY\""
            exit 1
        fi
        key_field="${provider}_api_key"
        python3 -c "
import json, os
cfg_path = os.path.expanduser('$CONFIG_FILE')
os.makedirs(os.path.dirname(cfg_path), exist_ok=True)
data = {}
if os.path.exists(cfg_path):
    try:
        with open(cfg_path) as f: data = json.load(f)
    except: pass
data['$key_field'] = '$key'
if '$provider' == 'sarvam':
    data['stt_backend'] = 'sarvam'
elif '$provider' == 'gemini':
    data['stt_backend'] = 'gemini'
with open(cfg_path, 'w') as f:
    json.dump(data, f, indent=2)
print('✅ Saved $key_field and updated STT backend in ' + cfg_path)
"
        echo "Restarting daemon to apply new key..."
        systemctl --user restart omarchy-assistant.service 2>/dev/null || true
        ;;

    status)
        echo "=== Omarchy Voice Assistant Status ==="
        if is_daemon_running; then
            echo "Daemon: RUNNING (Socket: $SOCKET_PATH)"
            send_socket '{"action": "status"}' | jq . 2>/dev/null || true
        else
            echo "Daemon: STOPPED (Socket: $SOCKET_PATH not found)"
        fi
        echo "Config file: $CONFIG_FILE"
        if [[ -f "$CONFIG_FILE" ]]; then
            echo "--- Active Config ---"
            jq . "$CONFIG_FILE" 2>/dev/null || cat "$CONFIG_FILE"
        fi
        ;;

    daemon-service)
        export PYTHONPATH="$REPO_DIR:${PYTHONPATH:-}"
        exec python3 -m daemon.main
        ;;

    start)
        if is_daemon_running; then
            echo "Omarchy Assistant daemon is already running."
            exit 0
        fi
        echo "Starting Omarchy Assistant daemon..."
        PYTHONPATH="$REPO_DIR:${PYTHONPATH:-}" nohup python3 -m daemon.main >/dev/null 2>&1 &
        sleep 1
        if is_daemon_running; then
            echo "Daemon started successfully."
        else
            echo "Failed to start daemon." >&2
            exit 1
        fi
        ;;

    stop)
        if is_daemon_running; then
            pkill -f "python3 -m daemon.main" || true
            rm -f "$SOCKET_PATH"
            echo "Omarchy Assistant daemon stopped."
        else
            echo "Daemon was not running."
        fi
        ;;

    restart)
        "$0" stop
        sleep 0.5
        "$0" start
        ;;

    service)
        subaction="${2:-status}"
        systemctl --user "$subaction" omarchy-assistant.service
        ;;

    meeting)
        subcmd="${2:-status}"
        case "$subcmd" in
            start)
                send_socket '{"action": "meeting_start"}'
                ;;
            stop)
                send_socket '{"action": "meeting_stop"}'
                ;;
            status)
                send_socket '{"action": "meeting_status"}'
                ;;
            list)
                ls -la "${HOME}/Documents/Omarchy-Transcripts/" 2>/dev/null || echo "No transcripts yet."
                ;;
            *)
                echo "Usage: omarchy-assistant meeting {start|stop|status|list}"
                ;;
        esac
        ;;

    config)
        sub="${2:-show}"
        if [[ "$sub" == "edit" ]]; then
            ${EDITOR:-nano} "$CONFIG_FILE"
        else
            if [[ -f "$CONFIG_FILE" ]]; then
                jq . "$CONFIG_FILE" 2>/dev/null || cat "$CONFIG_FILE"
            else
                echo "Config file does not exist yet ($CONFIG_FILE)."
            fi
        fi
        ;;

    -h|--help|help)
        usage
        ;;

    *)
        echo "Unknown command: $cmd" >&2
        usage
        exit 1
        ;;
esac
